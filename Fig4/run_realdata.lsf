#BSUB -J realdata[1-13]
#BSUB -W 23:00
#BSUB -o Fig4/errDir/realdata_%I.out
#BSUB -e Fig4/errDir/realdata_%I.err
#BSUB -q medium
#BSUB -n 8
#BSUB -R "span[hosts=1] rusage[mem=64]"
#BSUB -M 64

# run 1-13   (jobs listed in Fig4/realdata_fit.R)
# Submit from the repository root after Data/run_prepare.lsf:  bsub < Fig4/run_realdata.lsf
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Fig4/realdata_fit.R $LSB_JOBINDEX
