#BSUB -J rho_comp_rp_csm[1-200]%200
#BSUB -W 12:00
#BSUB -o Fig3/errDir/rho_comp_rp_csm_%I.out
#BSUB -e Fig3/errDir/rho_comp_rp_csm_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-200
# Submit from the repository root:  bsub < Fig3/run_rho_comp_rp_csm.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Fig3/rho_comp_rp_csm_sim.R $LSB_JOBINDEX
