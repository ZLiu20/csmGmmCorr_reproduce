#BSUB -J prepare[1-3]
#BSUB -W 8:00
#BSUB -o Data/errDir/prepare_%I.out
#BSUB -e Data/errDir/prepare_%I.err
#BSUB -q medium
#BSUB -n 1
#BSUB -R "span[hosts=1] rusage[mem=64]"
#BSUB -M 64

# run 1-3   (1: GLGC replication, 2: GLGC lipid pleiotropy, 3: UK Biobank pleiotropy)
# Submit from the repository root after bash Data/download_data.sh:  bsub < Data/run_prepare.lsf
module load R/4.5.1
case $LSB_JOBINDEX in
  1) Rscript Data/prepare_glgc.R replication && touch Data/prepared/glgc_replication/DONE ;;
  2) Rscript Data/prepare_glgc.R pleiotropy && touch Data/prepared/glgc_pleiotropy/DONE ;;
  3) Rscript Data/prepare_ukb.R && touch Data/prepared/ukb_pleiotropy/DONE ;;
esac
