#!/usr/bin/env bash
#BSUB -J csm_prepare[1-3]
#BSUB -q long
#BSUB -W 08:00
#BSUB -n 1
#BSUB -M 64
#BSUB -R "rusage[mem=64]"
#BSUB -o Data/errDir/prepare_%J_%I.out
#BSUB -e Data/errDir/prepare_%J_%I.err
set -euo pipefail
module load R/4.5.1
case "${LSB_JOBINDEX:?}" in
  1) Rscript Data/prepare_glgc.R replication ;;
  2) Rscript Data/prepare_glgc.R pleiotropy ;;
  3) Rscript Data/prepare_ukb.R ;;
esac
