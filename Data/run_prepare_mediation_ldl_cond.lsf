# run 1   Conditional alpha (Data/prepare_mediation_ldl_cond.R), after Data/prepare_mediation_ldl.R.
# Set BFILE to the 1000 Genomes EUR PLINK fileset (build 37) and PLINK to the plink 1.9 binary.
module load R/4.5.1
Rscript Data/prepare_mediation_ldl_cond.R "$BFILE" "${PLINK:-plink}"
