#BSUB -J main_comp_pl_csm[1-360]%200
#BSUB -W 12:00
#BSUB -o Tab2/errDir/main_comp_pl_csm_%I.out
#BSUB -e Tab2/errDir/main_comp_pl_csm_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-360
# Submit from the repository root:  bsub < Tab2/run_main_comp_pl_csm.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Tab2/main_comp_pl_csm_sim.R $LSB_JOBINDEX
