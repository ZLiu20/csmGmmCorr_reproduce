#BSUB -J ld_ours_med_pen[1-120]%200
#BSUB -W 12:00
#BSUB -o Tab2/errDir/ld_ours_med_pen_%I.out
#BSUB -e Tab2/errDir/ld_ours_med_pen_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-120
# Submit from the repository root:  bsub < Tab2/run_ld_ours_med_pen.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Tab2/ld_ours_med_pen_sim.R $LSB_JOBINDEX
