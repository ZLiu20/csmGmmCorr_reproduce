#BSUB -J main_ours_med_pen_A[1-60]%200
#BSUB -W 12:00
#BSUB -o SuppTab9/errDir/main_ours_med_pen_A_%I.out
#BSUB -e SuppTab9/errDir/main_ours_med_pen_A_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-60
# Submit from the repository root:  bsub < SuppTab9/run_main_ours_med_pen_A.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript SuppTab9/main_ours_med_pen_A_sim.R $LSB_JOBINDEX
