#BSUB -J main_ours_pl_pen_C[1-30]%200
#BSUB -W 16:00
#BSUB -o SuppTab9/errDir/main_ours_pl_pen_C_%I.out
#BSUB -e SuppTab9/errDir/main_ours_pl_pen_C_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-30
# Submit from the repository root:  bsub < SuppTab9/run_main_ours_pl_pen_C.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript SuppTab9/main_ours_pl_pen_C_sim.R $LSB_JOBINDEX
