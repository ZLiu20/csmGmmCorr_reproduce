#BSUB -J main_comp_pl[1-480]%200
#BSUB -W 4:00
#BSUB -o Fig2/errDir/main_comp_pl_%I.out
#BSUB -e Fig2/errDir/main_comp_pl_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=4]"
#BSUB -M 4

# run 1-480
# Submit from the repository root:  bsub < Fig2/run_main_comp_pl.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Fig2/main_comp_pl_sim.R $LSB_JOBINDEX
