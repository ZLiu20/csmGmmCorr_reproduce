#BSUB -J sym_ours_pl_ml[1-480]%200
#BSUB -W 12:00
#BSUB -o Fig2/errDir/sym_ours_pl_ml_%I.out
#BSUB -e Fig2/errDir/sym_ours_pl_ml_%I.err
#BSUB -q medium
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=8]"
#BSUB -M 8

# run 1-480
# Submit from the repository root:  bsub < Fig2/run_sym_ours_pl_ml.lsf
# (queue, memory unit and module name may need to be adapted to the cluster)
module load R/4.5.1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
Rscript Fig2/sym_ours_pl_ml_sim.R $LSB_JOBINDEX
